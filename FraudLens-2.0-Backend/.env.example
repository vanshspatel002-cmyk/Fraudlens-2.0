# Copy this file to .env locally, or set these values in the backend host.
# .env is gitignored and must never be committed.

# An explicit SQLite file selects rollback/research even with DATABASE_URL set.
# For PostgreSQL set FRAUDLENS_DB=postgresql (or omit it with DATABASE_URL set),
# after importing and validating the selected demo with migrate_postgres.py.
FRAUDLENS_DB=outputs/pilot_validation/demo.db
# DATABASE_URL=  # Set privately on the backend only. Never copy to VITE_*.
FRAUDLENS_PG_SCHEMA=fraudlens_pilot
FRAUDLENS_SQLITE_ROLLBACK=outputs/pilot_validation/demo.db
# Local pilot evidence paths. Database migration does not move evidence bytes.
# Deployment uses scripts/start_deployment.py and requires an existing private
# volume mount FRAUDLENS_PERSISTENT_ROOT; all mutable paths below must then be
# absolute paths within it. Restore existing ledgers instead of creating new ones.
# FRAUDLENS_PERSISTENT_ROOT=/app/storage
FRAUDLENS_DATA_DIR=data
FRAUDLENS_UPLOAD_DIR=outputs/pilot_validation/uploads
FRAUDLENS_THUMB_DIR=outputs/pilot_validation/thumbnails
# GEMINI_QUOTA_BUDGET=outputs/pilot_validation/quota_budget.json
# Preserve the existing stopped ledger across restarts and database switches.
FRAUDLENS_LIVE_LEDGER=outputs/pilot_validation/live_calls.json
FRAUDLENS_LIVE_LIMIT=15

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
FRAUDLENS_LOG_LEVEL=INFO
FRAUDLENS_RATE_LIMIT_WINDOW_SECONDS=60
FRAUDLENS_RATE_LIMIT_SUBMIT_MAX=6
FRAUDLENS_RATE_LIMIT_TRACK_MAX=30
FRAUDLENS_HEALTH_GEMINI_TTL_SECONDS=900

# Admin access. Generate the hash from a strong password and keep the password
# itself outside the repository.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SHA256=

# Optional server-to-server bearer token accepted by protected endpoints.
EVIDENCE_SERVICE_TOKEN=

# Gemini model access.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash
LLM_PROVIDER=gemini

# Local-only fallback. Do not enable this on Railway unless you provide an
# Ollama service reachable from the backend container.
# OLLAMA_MODEL=moondream
# OLLAMA_HOST=http://localhost:11434
